---
import { defaultLang, type SupportedLanguage, useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const faqs = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
  { q: t('faq.q6'), a: t('faq.a6') },
];
---

<section id="faq" class="py-16 sm:py-20 border-t border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 sm:mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {t('faq.title')}
      </h2>
      <p class="mt-3 text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {t('faq.subtitle')}
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details
          class="group border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 rounded-xl overflow-hidden transition-all duration-200 hover:border-slate-300 dark:hover:border-slate-700 open:shadow-sm"
        >
          <summary class="flex items-center justify-between p-5 text-left font-semibold text-slate-900 dark:text-white cursor-pointer select-none list-none focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
            <span class="text-base sm:text-lg pr-4">{faq.q}</span>
            <span class="shrink-0 w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform duration-200">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 text-sm sm:text-base text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800/60 pt-4">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
