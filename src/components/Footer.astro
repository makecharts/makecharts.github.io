---
import { defaultLang, type SupportedLanguage, useTranslations, languages, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const supportUrl = 'https://buymeacoffee.com/kisharadilz';
const currentPathname = Astro.url.pathname;
---

<footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Column 1: Brand & Privacy -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-theme-orange flex items-center justify-center text-slate-950 font-bold shadow-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
              <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
            </svg>
          </div>
          <span class="text-base font-bold text-slate-900 dark:text-white">MakeCharts</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          {t('footer.brandDesc')}
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-theme-green/10 text-emerald-800 dark:text-theme-green text-xs font-medium border border-theme-green/30">
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          <span>{t('footer.privacyPledge')}</span>
        </div>
      </div>

      <!-- Column 2: Languages -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          {t('nav.selectLanguage')}
        </h4>
        <ul class="space-y-2 text-sm">
          {Object.entries(languages).map(([code, label]) => {
            const target = getLocalizedPath(code as SupportedLanguage, currentPathname);
            const isCurrent = code === lang;
            return (
              <li>
                <a
                  href={target}
                  class={`transition-colors ${
                    isCurrent
                      ? 'text-theme-orange font-semibold'
                      : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
                  }`}
                >
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Column 3: Support & Links -->
      <div class="space-y-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-white">
          {t('nav.support')}
        </h4>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          {t('footer.supportPrompt')}
        </p>
        <a
          href={supportUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#FFDD00] hover:bg-[#FFDD00]/90 text-black font-semibold text-xs rounded-lg px-3.5 py-2 transition-transform hover:scale-105"
        >
          <svg class="w-4 h-4 text-black shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.216 6.415l-.132-.666c-.119-.599-.388-1.119-.8-1.55-.411-.43-.93-.728-1.55-.885-.62-.158-1.32-.158-2.096-.158H6.554c-.776 0-1.476 0-2.096.158-.62.157-1.139.455-1.55.885-.412.431-.681.951-.8 1.55L1.976 6.415C1.84 7.102 1.77 7.79 1.77 8.48c0 3.27 1.83 6.16 4.67 7.42.3.13.62.25.96.34.84.23 1.73.35 2.64.35h3.92c.91 0 1.8-.12 2.64-.35.34-.09.66-.21.96-.34 2.84-1.26 4.67-4.15 4.67-7.42 0-.69-.07-1.378-.214-2.065zM18.8 8.48c0 2.21-1.35 4.1-3.32 4.95-.3.13-.62.24-.96.33-.84.22-1.73.34-2.64.34H7.96c-.91 0-1.8-.12-2.64-.34-.34-.09-.66-.2-.96-.33-1.97-.85-3.32-2.74-3.32-4.95 0-.58.06-1.16.18-1.74l.13-.67c.07-.35.21-.65.44-.89.23-.24.52-.41.88-.5.36-.09.82-.09 1.39-.09h9.84c.57 0 1.03 0 1.39.09.36.09.65.26.88.5.23.24.37.54.44.89l.13.67c.12.58.18 1.16.18 1.74zM4.92 18.25h14.16v1.5H4.92z" />
          </svg>
          <span>{t('footer.supportButton')}</span>
        </a>
        <div class="pt-2">
          <a
            href="https://github.com/makecharts/makecharts.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-slate-500 hover:text-slate-800 dark:hover:text-slate-300 transition-colors inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>{t('nav.github')}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>© {currentYear} {t('footer.copyright')}</p>
      <p>{t('footer.builtWith')}</p>
    </div>
  </div>
</footer>
