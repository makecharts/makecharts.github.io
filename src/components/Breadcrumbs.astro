---
import { defaultLang, type SupportedLanguage, useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = getLocalizedPath(lang, '/');
---

<nav aria-label="Breadcrumb" class="flex justify-center mb-5">
  <ol class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 text-xs font-medium text-slate-500 dark:text-slate-400 shadow-2xs">
    <li class="inline-flex items-center">
      <a
        href={homeUrl}
        class="inline-flex items-center gap-1 hover:text-theme-orange transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        <span>{t('breadcrumbs.home')}</span>
      </a>
    </li>
    <li aria-hidden="true">
      <span class="text-slate-300 dark:text-slate-600">/</span>
    </li>
    <li class="inline-flex items-center font-semibold text-slate-800 dark:text-slate-200" aria-current="page">
      <span>{t('breadcrumbs.studio')}</span>
    </li>
  </ol>
</nav>
