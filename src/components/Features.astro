---
import { defaultLang, type SupportedLanguage, useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const features = [
  {
    icon: 'shield',
    title: t('features.privacyTitle'),
    desc: t('features.privacyDesc'),
    badge: 'Privacy 100%',
    color: 'text-theme-green bg-theme-green/10 border-theme-green/30',
  },
  {
    icon: 'vector',
    title: t('features.svgTitle'),
    desc: t('features.svgDesc'),
    badge: 'Vector SVG',
    color: 'text-theme-teal bg-theme-teal/10 border-theme-teal/30',
  },
  {
    icon: 'image',
    title: t('features.pngTitle'),
    desc: t('features.pngDesc'),
    badge: 'Retina 2.5x',
    color: 'text-theme-orange bg-theme-orange/10 border-theme-orange/30',
  },
  {
    icon: 'sheet',
    title: t('features.csvTitle'),
    desc: t('features.csvDesc'),
    badge: 'CSV / TSV',
    color: 'text-amber-600 dark:text-amber-300 bg-theme-cream dark:bg-amber-950/40 border-amber-300/60 dark:border-amber-700/60',
  },
  {
    icon: 'sliders',
    title: t('features.responsiveTitle'),
    desc: t('features.responsiveDesc'),
    badge: 'Mobile & Desktop',
    color: 'text-theme-teal bg-theme-teal/10 border-theme-teal/30',
  },
  {
    icon: 'zap',
    title: t('features.freeTitle'),
    desc: t('features.freeDesc'),
    badge: 'Zero Friction',
    color: 'text-theme-green bg-theme-green/10 border-theme-green/30',
  },
];
---

<section id="features" class="py-16 sm:py-20 border-t border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {t('features.title')}
      </h2>
      <p class="mt-3 text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {t('features.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {features.map((feat) => (
        <div class="relative flex flex-col p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/70 shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all group">
          <div class="flex items-center justify-between mb-4">
            <div class={`w-11 h-11 rounded-xl flex items-center justify-center border ${feat.color}`}>
              {feat.icon === 'shield' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              )}
              {feat.icon === 'vector' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
              )}
              {feat.icon === 'image' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                  <circle cx="9" cy="9" r="2" />
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                </svg>
              )}
              {feat.icon === 'sheet' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                  <polyline points="14 2 14 8 20 8" />
                  <path d="M8 13h2" />
                  <path d="M8 17h2" />
                  <path d="M14 13h2" />
                  <path d="M14 17h2" />
                </svg>
              )}
              {feat.icon === 'sliders' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 21v-7" />
                  <path d="M4 10V3" />
                  <path d="M12 21v-9" />
                  <path d="M12 8V3" />
                  <path d="M20 21v-5" />
                  <path d="M20 12V3" />
                  <path d="M1 14h6" />
                  <path d="M9 8h6" />
                  <path d="M17 16h6" />
                </svg>
              )}
              {feat.icon === 'zap' && (
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
              )}
            </div>
            <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
              {feat.badge}
            </span>
          </div>

          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
            {feat.title}
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {feat.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
