---
import Layout from '../layouts/Layout.astro';
import ChartWorkspace from '../components/ChartWorkspace.jsx';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Faq from '../components/Faq.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout lang={lang}>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-10 sm:pt-16 sm:pb-14 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- Privacy Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-theme-cream dark:bg-slate-900 border border-amber-200/80 dark:border-amber-900/40 text-amber-950 dark:text-amber-200 text-xs font-semibold mb-6 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-theme-green animate-pulse"></span>
        <span>{t('hero.privacyBadge')}</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white max-w-4xl mx-auto leading-tight sm:leading-none">
        {t('hero.title')}
      </h1>

      <!-- Subtitle -->
      <p class="mt-4 sm:mt-6 text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {t('hero.subtitle')}
      </p>
    </div>
  </section>

  <!-- Interactive Chart Workspace (React Island) -->
  <section id="workspace" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20">
    <ChartWorkspace client:load lang={lang} />
  </section>

  <!-- Static SEO Content Sections -->
  <Features lang={lang} />
  <HowItWorks lang={lang} />
  <Faq lang={lang} />
</Layout>
