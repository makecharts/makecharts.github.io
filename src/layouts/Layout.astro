---
import '../styles/global.css';
import { defaultLang, type SupportedLanguage, useTranslations, getHreflangLinks } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLanguage;
}

const { lang = defaultLang, title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title || t('site.title');
const pageDescription = description || t('site.description');
const currentPathname = Astro.url.pathname;
const siteUrl = 'https://makecharts.github.io';
const canonicalUrl = new URL(currentPathname, siteUrl).href;
const hreflangLinks = getHreflangLinks(currentPathname, siteUrl);

const jsonLdSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      name: 'MakeCharts',
      url: canonicalUrl,
      description: pageDescription,
      applicationCategory: 'DesignApplication, UtilityApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires modern web browser with JavaScript enabled',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      creator: {
        '@type': 'Person',
        name: 'Kishara Dilshan',
        url: 'https://buymeacoffee.com/kisharadilz',
      },
    },
    {
      '@type': 'HowTo',
      '@id': `${siteUrl}/#howto`,
      name: t('howItWorks.title'),
      description: t('howItWorks.subtitle'),
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t('howItWorks.step1Title'),
          text: t('howItWorks.step1Desc'),
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t('howItWorks.step2Title'),
          text: t('howItWorks.step2Desc'),
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t('howItWorks.step3Title'),
          text: t('howItWorks.step3Desc'),
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: t('faq.q1'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a1'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q2'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a2'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q3'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a3'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q4'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a4'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q5'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a5'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q6'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a6'),
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="pie chart maker, bar chart maker, online chart generator, free chart maker, svg chart export, png chart export, recharts, makecharts, privacy first chart maker" />
    <meta name="author" content="MakeCharts" />
    <meta name="theme-color" content="#2563EB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- 7 Bidirectional hreflang Alternate Tags -->
    {hreflangLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={entry.href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="MakeCharts" />
    <meta property="og:image" content="https://makecharts.github.io/favicon.svg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content="https://makecharts.github.io/favicon.svg" />

    <!-- Anti-FOUC Theme Script (Instant Execution Before Render) -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}

        // Clean up lingering Service Workers from previous projects on localhost
        if ('serviceWorker' in navigator && (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')) {
          navigator.serviceWorker.getRegistrations().then(function (registrations) {
            for (var i = 0; i < registrations.length; i++) {
              registrations[i].unregister();
            }
          }).catch(function () {});
        }
      })();
    </script>

    <!-- Combined Structured Data (WebApplication, HowTo, FAQPage) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Z4CKBLCN0B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Z4CKBLCN0B');
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-200">
    <Header lang={lang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
