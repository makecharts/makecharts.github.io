---
import '../styles/global.css';
import { defaultLang, type SupportedLanguage, useTranslations, getHreflangLinks, supportedLocales } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLanguage;
}

const { lang = defaultLang, title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title || t('site.title');
const pageDescription = description || t('site.description');
const currentPathname = Astro.url.pathname;
const siteUrl = 'https://makecharts.github.io';
const canonicalUrl = new URL(currentPathname, siteUrl).href;
const hreflangLinks = getHreflangLinks(currentPathname, siteUrl);

const ogImageUrl = 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';

const ogLocaleMap: Record<SupportedLanguage, string> = {
  en: 'en_US',
  es: 'es_ES',
  pt: 'pt_BR',
  de: 'de_DE',
  fr: 'fr_FR',
  ja: 'ja_JP',
};

const jsonLdSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'MakeCharts',
      description: 'Free Online Pie & Bar Chart Generator',
      inLanguage: lang,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t('breadcrumbs.home'),
          item: `${siteUrl}${lang === defaultLang ? '/' : `/${lang}/`}`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t('breadcrumbs.studio'),
          item: `${canonicalUrl}#workspace`,
        },
      ],
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      name: 'MakeCharts',
      url: canonicalUrl,
      description: pageDescription,
      applicationCategory: 'DesignApplication, UtilityApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires modern web browser with JavaScript enabled',
      screenshot: ogImageUrl,
      softwareVersion: '1.0.0',
      featureList: [
        'Interactive Pie & Bar Charts',
        'Direct CSV/TSV data pasting',
        'Instant Vector SVG download',
        'High-Resolution PNG export',
        'Watermark-free export option',
        '100% client-side privacy',
      ],
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      creator: {
        '@type': 'Person',
        name: 'Kishara Dilshan',
        url: 'https://buymeacoffee.com/kisharadilz',
      },
    },
    {
      '@type': 'HowTo',
      '@id': `${siteUrl}/#howto`,
      name: t('howItWorks.title'),
      description: t('howItWorks.subtitle'),
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t('howItWorks.step1Title'),
          text: t('howItWorks.step1Desc'),
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t('howItWorks.step2Title'),
          text: t('howItWorks.step2Desc'),
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t('howItWorks.step3Title'),
          text: t('howItWorks.step3Desc'),
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: t('faq.q1'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a1'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q2'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a2'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q3'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a3'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q4'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a4'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q5'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a5'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q6'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a6'),
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Performance & Resource Preconnect Hints -->
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content="pie chart maker, bar chart maker, online chart generator, free chart maker, svg chart export, png chart export, recharts, makecharts, privacy first chart maker" />
    <meta name="author" content="MakeCharts" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#FF9D50" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- 7 Bidirectional hreflang Alternate Tags -->
    {hreflangLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={entry.href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="MakeCharts" />
    <meta property="og:locale" content={ogLocaleMap[lang] || 'en_US'} />
    {supportedLocales.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={ogLocaleMap[l]} />
    ))}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MakeCharts - Free Online Pie & Bar Chart Generator" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content={ogImageUrl} />
    <meta property="twitter:image:alt" content="MakeCharts - Free Online Pie & Bar Chart Generator" />

    <!-- Anti-FOUC Theme Script (Instant Execution Before Render) -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}

        // Clean up lingering Service Workers from previous projects on localhost
        if ('serviceWorker' in navigator && (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')) {
          navigator.serviceWorker.getRegistrations().then(function (registrations) {
            for (var i = 0; i < registrations.length; i++) {
              registrations[i].unregister();
            }
          }).catch(function () {});
        }
      })();
    </script>

    <!-- Combined Structured Data (WebApplication, HowTo, FAQPage) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-Z4CKBLCN0B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-Z4CKBLCN0B');
    </script>
  </head>
  <body class="flex flex-col min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-200">
    <Header lang={lang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
